{
  "name": "@getomnichain/omnichain",
  "version": "0.7.2",
  "description": "Multi-chain SDK for EVM, Solana, UTXO (BTC/LTC/DOGE/DASH/ZEC/BCH), Stellar, Tron, and TON. TypeScript parity port of omnichain-py.",
  "keywords": [
    "omnichain",
    "blockchain",
    "evm",
    "ethereum",
    "solana",
    "bitcoin",
    "utxo",
    "stellar",
    "ton",
    "tron",
    "sdk",
    "multichain",
    "web3"
  ],
  "homepage": "https://github.com/getomnichain/omnichain#readme",
  "bugs": "https://github.com/getomnichain/omnichain/issues",
  "license": "MIT",
  "author": "getomnichain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getomnichain/omnichain.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./evm": {
      "types": "./dist/esm/evm/index.d.ts",
      "import": "./dist/esm/evm/index.js",
      "require": "./dist/cjs/evm/index.js"
    },
    "./solana": {
      "types": "./dist/esm/solana/index.d.ts",
      "import": "./dist/esm/solana/index.js",
      "require": "./dist/cjs/solana/index.js"
    },
    "./utxo": {
      "types": "./dist/esm/utxo/index.d.ts",
      "import": "./dist/esm/utxo/index.js",
      "require": "./dist/cjs/utxo/index.js"
    },
    "./ton": {
      "types": "./dist/esm/ton/index.d.ts",
      "import": "./dist/esm/ton/index.js",
      "require": "./dist/cjs/ton/index.js"
    },
    "./stellar": {
      "types": "./dist/esm/stellar/index.d.ts",
      "import": "./dist/esm/stellar/index.js",
      "require": "./dist/cjs/stellar/index.js"
    },
    "./tron": {
      "types": "./dist/esm/tron/index.d.ts",
      "import": "./dist/esm/tron/index.js",
      "require": "./dist/cjs/tron/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && npm run build:esm && npm run build:cjs && node scripts/write-dist-pkg-types.mjs",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js",
    "test:live:ton": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js -c jest.live.config.mjs ton/test/live",
    "release": "bash scripts/release.sh",
    "rango:refresh": "node scripts/refresh-rango-fixture.mjs",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "axios": "^1.7.0",
    "bitcoinjs-lib": "^7.0.1",
    "bitcoinjs-message": "^2.2.0",
    "bs58": "^6.0.0",
    "coininfo": "^5.2.1",
    "decimal.js": "^10.4.3",
    "ethers": "^6.13.0",
    "js-sha3": "^0.9.3",
    "tiny-secp256k1": "^2.2.3"
  },
  "peerDependencies": {
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0 || ^0.15.0 || ^0.16.0"
  },
  "peerDependenciesMeta": {
    "class-transformer": {
      "optional": false
    },
    "class-validator": {
      "optional": false
    }
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
