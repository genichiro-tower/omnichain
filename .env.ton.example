# Copy to .env.ton.local (git-ignored) for `npm run test:live:ton`. Mainnet, real TON.

# Provider keys. Both are required: the suite checks the providers against each other.
TONCENTER_API_KEY=
TONAPI_API_KEY=

# A BIP-39 mnemonic used ONLY for these tests — never a production one.
TON_LIVE_MNEMONIC=
# The fee payer's account index (m/44'/607'/<n>'); fund it with ~1 TON. Vaults are
# the next never-used indices above it.
TON_LIVE_FEE_PAYER_ACCOUNT=0
# Most the run may spend, in nanotons (0.1 TON).
TON_LIVE_MAX_SPEND_NANO=100000000

# Off by default: 1 broadcasts real transactions; 1 rewrites ton/test/fixtures/mainnet_recordings.json.
TON_LIVE_SEND=0
TON_LIVE_RECORD=0
